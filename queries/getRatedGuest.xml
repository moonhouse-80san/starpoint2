<?xml version="1.0" encoding="utf-8"?>
<query id="getRatedGuest" action="select">
	<tables>
		<table name="document_star" />
	</tables>
	<columns>
		<column name="star_rate" />
	</columns>
	<conditions>
		<condition operation="equal" column="member_srl" default="0" notnull="notnull" />
		<condition operation="equal" column="document_srl" var="document_srl" filter="number" notnull="notnull" />
		<condition operation="equal" column="ipaddress" var="ipaddress" notnull="notnull" />
	</conditions>
</query>
